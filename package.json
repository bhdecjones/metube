{
  "name": "metube-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm --workspace @metube/web run dev",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": "22.x"
  }
}
